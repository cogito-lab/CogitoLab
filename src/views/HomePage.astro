---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import InitiativeCard from '@/components/InitiativeCard.astro';
import OpportunityCard from '@/components/OpportunityCard.astro';
import MemberCard from '@/components/MemberCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import Icon from '@/components/Icon.astro';
import { allAreas } from '@/data/areas';
import { pillars } from '@/data/pillars';
import { selectHomeInitiatives, homeImpactGroups } from '@/utils/home';
import {
  getInitiatives,
  getOpportunities,
  getPeople,
  getNews,
  getPrograms,
  validateContentRelations,
} from '@/utils/content';
import { localizedPath, pick, withBase, type Lang } from '@/utils/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
await validateContentRelations();
const [initiatives, opportunities, people, news, programs, publications] = await Promise.all([
  getInitiatives(),
  getOpportunities(),
  getPeople(),
  getNews(),
  getPrograms(),
  getCollection('publications'),
]);
const featured = selectHomeInitiatives(initiatives);
const impactGroups = homeImpactGroups(initiatives, programs, publications);
const openOpportunities = opportunities
  .filter((item) => item.data.status !== 'closed')
  .sort(
    (a, b) =>
      Number(b.data.status === 'open') - Number(a.data.status === 'open') ||
      a.data.order - b.data.order
  );
const activeOpps = openOpportunities.slice(0, 3);
const latestNews = news.slice(0, 3);
const title = 'Cogito Lab';
const description =
  lang === 'en'
    ? 'We investigate problems, develop technology solutions and share knowledge with society through software engineering, artificial intelligence and innovation.'
    : 'Investigamos problemas, desenvolvemos soluções tecnológicas e compartilhamos conhecimento com a sociedade por meio da engenharia de software, inteligência artificial e inovação.';
---

<BaseLayout lang={lang} title={title} description={description} path="/">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          {lang === 'en' ? 'Software · evidence · people' : 'Software · evidência · pessoas'}
        </p>
        <h1 class:list={{ 'hero-title--pt': lang === 'pt' }}>
          {lang === 'en' ? (
            <>
              We question.
              <br />
              <em>We build.</em>
            </>
          ) : (
            <>
              <span class="hero-phrase">Questionamos.</span>
              <em class="hero-phrase">Construímos.</em>
            </>
          )}
        </h1>
        <p class="lede">{description}</p>
        <div class="hero-actions">
          <a class="button" href={withBase(localizedPath('/research', lang))}>
            {lang === 'en' ? 'Explore our research' : 'Explore nossa pesquisa'}
            <Icon name="arrow" class="arrow" />
          </a>
          <a class="button button--ghost" href={withBase(localizedPath('/opportunities', lang))}>
            {lang === 'en' ? 'Find an opportunity' : 'Encontre uma oportunidade'}
          </a>
        </div>
      </div>
      <div class="hero-orbit" aria-hidden="true">
        <div class="orbit orbit--one"></div>
        <div class="orbit orbit--two"></div>
        <div class="orbit orbit--three"></div>
        <div class="core">
          <span>cogito</span>
          <strong>
            ergo
            <br />
            facio
          </strong>
        </div>
        <span class="node node--a">AI</span>
        <span class="node node--b">SE</span>
        <span class="node node--c">IoT</span>
        <span class="node node--d">QA</span>
      </div>
    </div>
    <div
      class="container stats"
      aria-label={lang === 'en' ? 'Lab at a glance' : 'O laboratório em números'}
    >
      <div>
        <strong>{String(allAreas.length).padStart(2, '0')}</strong>
        <span>{lang === 'en' ? 'Research areas' : 'Áreas de pesquisa'}</span>
      </div>
      <div>
        <strong>{String(initiatives.length).padStart(2, '0')}</strong>
        <span>{lang === 'en' ? 'Initiatives' : 'Iniciativas'}</span>
      </div>
      <div>
        <strong>{String(people.length).padStart(2, '0')}</strong>
        <span>{lang === 'en' ? 'People' : 'Integrantes'}</span>
      </div>
      <div>
        <strong>{String(openOpportunities.length).padStart(2, '0')}</strong>
        <span>{lang === 'en' ? 'Ways to join' : 'Formas de participar'}</span>
      </div>
    </div>
  </section>

  <section class="section container" id="pillars" aria-labelledby="pillars-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{lang === 'pt' ? 'Nossos três pilares' : 'Our three pillars'}</p>
        <h2 id="pillars-title">
          {lang === 'pt' ? 'Da pesquisa ao Impacto' : 'From Research to Impact'}
        </h2>
      </div>
      <p>
        {lang === 'pt'
          ? 'Investigamos problemas, desenvolvemos tecnologias e compartilhamos conhecimento para transformar ideias em resultados.'
          : 'We investigate problems, develop technologies and share knowledge to turn ideas into results.'}
      </p>
    </div>
    <div class="card-grid">
      {pillars.map((pillar) => (
        <article class={`card card--${pillar.tone} pillar-card`} data-pillar-card={pillar.id}>
          <div class="card__body">
            <h3>{pick(pillar.title, lang)}</h3>
            <p>{pick(pillar.description, lang)}</p>
          </div>
          <div class="card__footer">
            <a class="text-link" href={withBase(localizedPath(pillar.route, lang))}>
              {pick(pillar.action, lang)} <Icon name="arrow" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section work-preview" id="featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            {lang === 'en' ? 'Our work in motion' : 'Nossa atuação em movimento'}
          </p>
          <h2 id="featured-title">
            {lang === 'en' ? 'Selected Initiatives' : 'Iniciativas em Destaque'}
          </h2>
        </div>
        <p>
          {lang === 'en'
            ? 'Explore initiatives across research, extension and technology development, prioritizing work in progress.'
            : 'Conheça iniciativas de pesquisa, extensão e desenvolvimento tecnológico, com prioridade para as que estão em execução.'}
        </p>
      </div>
      <div class="card-grid">
        {featured.map((initiative, index) => (
          <InitiativeCard initiative={initiative} lang={lang} index={index} showClassification />
        ))}
      </div>
      <div class="section-action">
        <a class="button button--ghost" href={withBase(localizedPath('/initiatives', lang))}>
          {lang === 'en' ? 'Browse all initiatives' : 'Ver todas as iniciativas'}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  {impactGroups.length > 0 && (
    <section class="section container" id="impact" aria-labelledby="impact-title">
      <div class="section-heading">
        <div>
          <h2 id="impact-title">{lang === 'pt' ? 'Resultados e Impacto' : 'Results and Impact'}</h2>
        </div>
        <p>
          {lang === 'pt'
            ? 'Produção acadêmica e realizações verificadas dos integrantes e colaboradores.'
            : 'Academic output and verified achievements of our members and collaborators.'}
        </p>
      </div>
      <div class="impact-grid">
        {impactGroups.map(({ pillar, publicationCount, results }) => (
          <article class={`card card--${pillar.tone}`} data-impact-pillar={pillar.id}>
            <div class="card__body">
              <h3>{pick(pillar.title, lang)}</h3>
              {publicationCount > 0 && (
                <div>
                  <p class="impact-count">{publicationCount}</p>
                  <p>
                    {lang === 'pt'
                      ? 'Publicações dos integrantes e colaboradores, incluindo trabalhos anteriores ao Cogito Lab.'
                      : 'Publications by members and collaborators, including work predating Cogito Lab.'}
                  </p>
                  <a class="text-link" href={withBase(localizedPath('/publications', lang))}>
                    {lang === 'pt' ? 'Explorar publicações' : 'Explore publications'}{' '}
                    <Icon name="arrow" />
                  </a>
                </div>
              )}
              {results.length > 0 && (
                <ul class="impact-results">
                  {results.map((result) => (
                    <li>
                      <a href={result.url ?? withBase(localizedPath(result.sourcePath, lang))}>
                        {pick(result.description, lang)}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="section news-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{lang === 'en' ? 'Latest updates' : 'Últimas atualizações'}</p>
          <h2>{lang === 'en' ? 'News & Recognition' : 'Notícias e Reconhecimento'}</h2>
        </div>
        <p>
          {lang === 'en'
            ? 'Recent paper awards, conferences, talks, and community activities from Cogito Lab.'
            : 'Prêmios de artigos recentes, conferências, palestras e atividades do Cogito Lab com a comunidade.'}
        </p>
      </div>
      <div class="card-grid">
        {latestNews.map((item) => (
          <NewsCard news={item} lang={lang} />
        ))}
      </div>
      <div class="section-action">
        <a class="button button--ghost" href={withBase(localizedPath('/news', lang))}>
          {lang === 'en' ? 'View all news' : 'Ver todas as notícias'}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section people-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            {lang === 'en' ? 'The lab is its people' : 'O laboratório são as pessoas'}
          </p>
          <h2>
            {lang === 'en'
              ? 'Different Paths, Shared Inquiry'
              : 'Caminhos Diferentes, Investigação Compartilhada'}
          </h2>
        </div>
        <p>
          {lang === 'en'
            ? 'Students and collaborators across institutions bring complementary perspectives to every question.'
            : 'Estudantes e colaboradores de diferentes instituições trazem perspectivas complementares para cada pergunta.'}
        </p>
      </div>
      <div class="card-grid">
        {people.slice(0, 3).map((person) => (
          <MemberCard person={person} lang={lang} />
        ))}
      </div>
      <div class="section-action">
        <a class="button button--ghost" href={withBase(localizedPath('/people', lang))}>
          {lang === 'en' ? 'Meet the group' : 'Conheça o grupo'}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="section opportunity-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{lang === 'en' ? 'Come think with us' : 'Venha pensar conosco'}</p>
          <h2>
            {lang === 'en'
              ? 'Open Questions Need Curious People'
              : 'Perguntas Abertas Precisam de Pessoas Curiosas'}
          </h2>
        </div>
        <p>
          {lang === 'en'
            ? 'Explore concrete ways to contribute through research, thesis work, engineering, and collaboration.'
            : 'Explore formas concretas de contribuir por meio de pesquisa, TCC, engenharia e colaboração.'}
        </p>
      </div>
      <div class="card-grid">
        {activeOpps.map((opportunity) => (
          <OpportunityCard opportunity={opportunity} lang={lang} />
        ))}
      </div>
      <div class="section-action">
        <a class="button button--ghost" href={withBase(localizedPath('/opportunities', lang))}>
          {lang === 'pt' ? 'Ver todas as oportunidades' : 'View all opportunities'}
          <Icon name="arrow" class="arrow" />
        </a>
      </div>
    </div>
  </section>

  <section class="closing-statement">
    <div class="narrow">
      <p class="eyebrow">Cogito Lab</p>
      <blockquote>
        {lang === 'en'
          ? 'Better software begins with better questions—and the courage to test the answers.'
          : 'Software melhor começa com perguntas melhores — e com a coragem de testar as respostas.'}
      </blockquote>
      <a class="button" href={withBase(localizedPath('/about', lang))}>
        {lang === 'en' ? 'Learn about the lab' : 'Conheça o laboratório'}
        <Icon name="arrow" class="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    padding-top: clamp(3.5rem, 8vw, 8rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(20rem, 0.82fr);
    gap: 3rem;
    align-items: center;
    min-height: 34rem;
  }
  .hero h1 {
    margin-bottom: 1.7rem;
    font-size: clamp(2.8rem, 9vw, 7.7rem);
  }
  .hero h1.hero-title--pt {
    font-size: clamp(2.5rem, 6.6vw, 6rem);
  }
  .hero-title--pt .hero-phrase {
    display: block;
    white-space: nowrap;
  }
  .hero h1 em {
    color: var(--mint-deep);
    font-weight: inherit;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }
  .hero-orbit {
    position: relative;
    width: min(38vw, 30rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .orbit {
    position: absolute;
    inset: 12%;
    border: 1px solid var(--line);
    border-radius: 50%;
    animation: spin 34s linear infinite;
  }
  .orbit::before {
    position: absolute;
    top: -5px;
    left: 50%;
    width: 10px;
    height: 10px;
    content: '';
    border-radius: 50%;
    background: var(--mint-deep);
  }
  .orbit--two {
    inset: 25%;
    animation-direction: reverse;
    animation-duration: 22s;
    transform: rotate(35deg);
  }
  .orbit--two::before {
    background: var(--amber);
  }
  .orbit--three {
    inset: 0;
    border-style: dashed;
    animation-duration: 55s;
  }
  .core {
    position: absolute;
    inset: 34%;
    display: grid;
    place-content: center;
    border-radius: 50%;
    color: #10231d;
    background: var(--mint);
    text-align: center;
    box-shadow: var(--shadow);
  }
  .core span {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .core strong {
    font-family: Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.8rem);
    font-weight: 500;
    line-height: 1;
  }
  .node {
    position: absolute;
    display: grid;
    width: 3.2rem;
    height: 3.2rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    font-size: 0.7rem;
    font-weight: 800;
    box-shadow: var(--shadow);
  }
  .node--a {
    top: 4%;
    left: 15%;
  }
  .node--b {
    top: 20%;
    right: 2%;
  }
  .node--c {
    right: 10%;
    bottom: 12%;
  }
  .node--d {
    bottom: 2%;
    left: 16%;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats div {
    display: grid;
    gap: 0.2rem;
    padding: 1.5rem;
    border-right: 1px solid var(--line);
  }
  .stats div:last-child {
    border: 0;
  }
  .stats strong {
    font-family: Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 500;
    line-height: 1;
  }
  .stats span {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
  .text-link {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    margin-top: 1rem;
    font-size: 0.83rem;
    font-weight: 720;
  }
  .text-link :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
  }
  .work-preview {
    background: color-mix(in srgb, var(--paper-2) 72%, transparent);
  }
  .pillar-card .card__body {
    margin-top: 0.5rem;
  }
  .pillar-card h3 {
    font-size: clamp(1.6rem, 2.2vw, 2rem);
    overflow-wrap: anywhere;
  }
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1rem;
  }
  .impact-grid .card {
    min-height: 0;
  }
  .impact-grid .card__body {
    margin-block: 0.5rem;
  }
  .impact-grid .impact-count {
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--ink);
  }
  .impact-results {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
    padding-left: 1.2rem;
  }
  .section-action {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .opportunity-preview {
    border-top: 1px solid var(--line);
  }
  .closing-statement {
    padding-block: clamp(6rem, 12vw, 11rem);
    text-align: center;
    background: var(--ink);
    color: var(--paper);
  }
  .closing-statement .eyebrow {
    justify-content: center;
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }
  .closing-statement blockquote {
    margin-bottom: 2.5rem;
    font-family: Georgia, serif;
    font-size: clamp(2rem, 5vw, 4.6rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .closing-statement .button {
    border-color: var(--paper);
    color: var(--ink);
    background: var(--paper);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 850px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-orbit {
      width: min(80vw, 26rem);
    }
  }
  @media (max-width: 620px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats div:nth-child(2) {
      border-right: 0;
    }
    .stats div:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }
</style>
