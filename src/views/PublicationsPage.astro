---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { t, type Lang } from '@/utils/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = t(lang);
const publications = (await getCollection('publications'))
  .filter((publication) => !publication.data.draft)
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const years = [...new Set(publications.map((publication) => publication.data.year))];
const description =
  lang === 'en'
    ? 'Scientific and academic output by Cogito Lab members and collaborators, including earlier work and research results from current initiatives.'
    : 'Produção científica e acadêmica dos integrantes e colaboradores do Cogito Lab, incluindo trabalhos anteriores e resultados de pesquisas desenvolvidas no contexto das iniciativas atuais.';
---

<BaseLayout lang={lang} title={copy.publications} description={description} path="/publications">
  <PageHero
    eyebrow={copy.publications}
    title={lang === 'en' ? 'Research made inspectable' : 'Pesquisa que pode ser examinada'}
    description={description}
  />
  <section class="section container">
    {publications.length === 0 ? (
      <div class="empty-state">
        <h2>{copy.noPublications}</h2>
        <p>{copy.editHint}</p>
      </div>
    ) : (
      years.map((year) => (
        <section class="publication-year">
          <h2>{year}</h2>
          <div>
            {publications
              .filter((publication) => publication.data.year === year)
              .map((publication) => (
                <PublicationItem publication={publication} lang={lang} />
              ))}
          </div>
        </section>
      ))
    )}
  </section>
</BaseLayout>
