---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import FilterBar from '@/components/FilterBar.astro';
import InitiativeCard from '@/components/InitiativeCard.astro';
import { getInitiatives, getPrograms, entrySlug } from '@/utils/content';
import { pick, type Lang } from '@/utils/i18n';
import { initiativeGroups } from '@/utils/initiatives';
import { pillars, entityTypeLabels } from '@/data/pillars';
import { executionStatusLabels } from '@/data/technology';
import { allAreas } from '@/data/areas';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const [initiatives, programs] = await Promise.all([getInitiatives(), getPrograms()]);
const groups = initiativeGroups(initiatives);
const types = [...new Set(initiatives.map((entry) => entry.data.entityType))];
const description =
  lang === 'en'
    ? 'Explore research, extension and technology initiatives, organized by execution status.'
    : 'Explore iniciativas de pesquisa, extensão e desenvolvimento tecnológico, organizadas por situação de execução.';
---

<BaseLayout
  lang={lang}
  title={lang === 'en' ? 'Initiatives' : 'Iniciativas'}
  description={description}
  path="/initiatives"
>
  <PageHero
    eyebrow={lang === 'en' ? 'Initiatives' : 'Iniciativas'}
    title={lang === 'en' ? 'Ideas tested in the real world' : 'Ideias testadas no mundo real'}
    description={description}
  />
  <section class="section container">
    <FilterBar
      lang={lang}
      options={types.map((value) => ({ value, label: pick(entityTypeLabels[value], lang) }))}
      statuses={Object.entries(executionStatusLabels).map(([value, label]) => ({
        value,
        label: pick(label, lang),
      }))}
      pillars={pillars.map((pillar) => ({ value: pillar.id, label: pick(pillar.title, lang) }))}
      areas={allAreas.map((area) => ({ value: area.id, label: pick(area.title, lang) }))}
      kindAttribute="entityType"
      allowReset
    />
    {groups.map((group) => (
      <section
        class="initiative-group"
        data-filter-group={group.id}
        aria-labelledby={group.id + '-title'}
      >
        <h2 id={group.id + '-title'}>{pick(group.title, lang)}</h2>
        <div class="card-grid">
          {group.entries.map((initiative) => {
            const program = programs.find(
              (entry) => entrySlug(entry.id) === initiative.data.program
            );
            return (
              <InitiativeCard
                initiative={initiative}
                lang={lang}
                showClassification
                showTechnologyDetails
                programLabel={program?.data.name}
                programPath={
                  program
                    ? '/' +
                      (program.data.primaryPillar === 'technology'
                        ? 'projects'
                        : program.data.primaryPillar) +
                      '#' +
                      entrySlug(program.id)
                    : undefined
                }
              />
            );
          })}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .initiative-group + .initiative-group {
    margin-top: 4rem;
  }
  .initiative-group h2 {
    margin-bottom: 2rem;
  }
</style>
