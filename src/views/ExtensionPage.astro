---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import InitiativeCard from '@/components/InitiativeCard.astro';
import { getInitiatives, getPrograms, entrySlug } from '@/utils/content';
import { localizedPath, withBase, pick, type Lang } from '@/utils/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const pt = lang === 'pt';
const [initiatives, allPrograms] = await Promise.all([getInitiatives(), getPrograms()]);
const programs = allPrograms.filter((program) => program.data.primaryPillar === 'extension');
const extensionInitiatives = initiatives.filter(
  (initiative) =>
    initiative.data.primaryPillar === 'extension' ||
    initiative.data.relatedPillars.includes('extension')
);
const independent = extensionInitiatives.filter((initiative) => !initiative.data.program);
const achievedResults = extensionInitiatives.flatMap((initiative) =>
  initiative.data.achievedResults.map((result) => ({
    ...result,
    path: `/initiatives/${entrySlug(initiative.id)}`,
  }))
);
const description = pt
  ? 'Conectamos universidade e sociedade por meio de projetos, ações formativas e compartilhamento de conhecimento em Engenharia de Software e inovação.'
  : 'We connect university and society through projects, educational activities and shared knowledge in software engineering and innovation.';
---

<BaseLayout
  lang={lang}
  title={pt ? 'Extensão' : 'Extension'}
  description={description}
  path="/extension"
>
  <PageHero
    eyebrow={pt ? 'Universidade e sociedade' : 'University and society'}
    title={pt ? 'Extensão' : 'Extension'}
    description={description}
  />
  {programs.map((program) => {
    const id = entrySlug(program.id);
    const projects = extensionInitiatives.filter((initiative) => initiative.data.program === id);
    const projectsId = id === 'cogito-transfer' ? 'extension-projects' : `${id}-projects`;
    return (
      <section
        class="section container extension-program"
        id={id}
        data-program={id}
        aria-labelledby={`${id}-title`}
      >
        <div class="prose program-intro">
          <p class="eyebrow">{pt ? 'Programa de extensão' : 'Extension program'}</p>
          <h2 id={`${id}-title`}>{pick(program.data.name, lang)}</h2>
          <p>{pick(program.data.description, lang)}</p>
          {program.data.audience && (
            <p>
              <strong>{pt ? 'Público: ' : 'Audience: '}</strong>
              {pick(program.data.audience, lang)}
            </p>
          )}
          {pick(program.data.objectives, lang).length > 0 && (
            <div>
              <h3>{pt ? 'Objetivos do programa' : 'Program objectives'}</h3>
              <ul>
                {pick(program.data.objectives, lang).map((objective) => (
                  <li>{objective}</li>
                ))}
              </ul>
            </div>
          )}
          <div
            class="status-note"
            id={id === 'cogito-transfer' ? 'program-status' : `${id}-status`}
          >
            <h3>{pt ? 'Situação institucional' : 'Institutional status'}</h3>
            <p>{pick(program.data.institutionalStatus, lang)}</p>
          </div>
        </div>
        {projects.length > 0 && (
          <section class="program-projects" aria-labelledby={projectsId}>
            <h3 id={projectsId}>
              {pt ? 'Projetos Vinculados ao Programa' : 'Projects Linked to the Program'}
            </h3>
            {id === 'cogito-transfer' && (
              <p class="project-note">
                {pt
                  ? 'P1–P4 são identificadores internos, não números de registro institucional. As atividades e entregas apresentadas são possibilidades a definir; o registro dos projetos não representa aprovação automática de novas atividades ou parcerias.'
                  : 'P1–P4 are internal identifiers, not institutional registration numbers. The activities and outcomes presented are possibilities to scope; project registration does not automatically approve new activities or partnerships.'}
              </p>
            )}
            <div class="card-grid">
              {projects.map((initiative, index) => (
                <div class="project-item" data-program-project={entrySlug(initiative.id)}>
                  {initiative.data.extensionCode && (
                    <p class="eyebrow">{initiative.data.extensionCode}</p>
                  )}
                  <InitiativeCard
                    initiative={initiative}
                    lang={lang}
                    index={index}
                    showClassification
                    headingLevel="h4"
                    showActivities
                  />
                </div>
              ))}
            </div>
          </section>
        )}
        {program.data.achievedResults.length > 0 && (
          <section
            class="program-results"
            data-program-results={id}
            aria-labelledby={`${id}-results`}
          >
            <h3 id={`${id}-results`}>{pt ? 'Resultados consolidados' : 'Consolidated results'}</h3>
            <ul>
              {program.data.achievedResults.map((result) => (
                <li>
                  {result.url ? (
                    <a href={result.url}>{pick(result.description, lang)}</a>
                  ) : (
                    pick(result.description, lang)
                  )}
                </li>
              ))}
            </ul>
          </section>
        )}
      </section>
    );
  })}
  {independent.length > 0 && (
    <section
      class="section container independent-initiatives"
      id="other-extension"
      aria-labelledby="other-extension-title"
    >
      <div class="section-heading">
        <div>
          <h2 id="other-extension-title">
            {pt
              ? 'Outras Iniciativas de Extensão e Inovação'
              : 'Other Extension and Innovation Initiatives'}
          </h2>
        </div>
        <p>
          {pt
            ? 'Participações e colaborações em iniciativas independentes do Cogito Transfer. As responsabilidades específicas são apresentadas quando confirmadas em cada registro.'
            : 'Participation and collaboration in initiatives independent of Cogito Transfer. Specific responsibilities are presented when confirmed in each record.'}
        </p>
      </div>
      <div class="card-grid">
        {independent.map((initiative) => (
          <InitiativeCard
            initiative={initiative}
            lang={lang}
            showClassification
            showInstitutionalStatus
          />
        ))}
      </div>
    </section>
  )}
  {achievedResults.length > 0 && (
    <section
      class="section container prose"
      id="extension-results"
      aria-labelledby="extension-results-title"
    >
      <h2 id="extension-results-title">
        {pt ? 'Resultados e impacto social' : 'Results and social impact'}
      </h2>
      <ul>
        {achievedResults.map((result) => (
          <li>
            <a href={result.url ?? withBase(localizedPath(result.path, lang))}>
              {pick(result.description, lang)}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  <section class="section container prose" aria-labelledby="participate">
    <h2 id="participate">{pt ? 'Como Propor uma Ação' : 'How to Propose an Activity'}</h2>
    <p>
      {pt
        ? 'Estudantes, colaboradores e organizações externas podem apresentar um problema, o público beneficiado e uma proposta de escopo. Antes de iniciar, cada ação precisa definir:'
        : 'Students, collaborators and external organizations can present a problem, its beneficiaries and a proposed scope. Before starting, each activity needs to define:'}
    </p>
    <ul>
      <li>
        {pt
          ? 'Responsável do parceiro, interação externa, benefício público e participação formativa.'
          : 'Partner contact, external interaction, public benefit and student learning.'}
      </li>
      <li>
        {pt
          ? 'Escopo mínimo, entregas, indicadores de impacto e permissões institucionais.'
          : 'Minimum scope, deliverables, impact indicators and institutional permissions.'}
      </li>
      <li>
        {pt
          ? 'Dados e acessos, privacidade e LGPD, segurança e direitos sobre resultados e código.'
          : 'Data and access, privacy and LGPD compliance, security and rights over results and code.'}
      </li>
      <li>
        {pt
          ? 'Infraestrutura, custos e responsabilidade pela manutenção.'
          : 'Infrastructure, costs and maintenance responsibilities.'}
      </li>
    </ul>
    <p>
      {pt
        ? 'Uma iniciativa pode gerar pesquisa e extensão. A pesquisa exige questões, método e evidências; a extensão exige interação externa, participação formativa e benefício social. Cada dimensão mantém objetivos, registros, entregas e indicadores próprios.'
        : 'An initiative can generate both research and extension. Research requires questions, methods and evidence; extension requires external interaction, student learning and social benefit. Each dimension maintains its own objectives, records, deliverables and indicators.'}
    </p>
    <a class="button" href={withBase(localizedPath('/about#contact', lang))}>
      {pt ? 'Converse com o Cogito Lab' : 'Contact Cogito Lab'}
    </a>
    <p class="catalog-link">
      <a href={withBase(localizedPath('/initiatives', lang))}>
        {pt ? 'Explorar todas as iniciativas' : 'Explore all initiatives'}
      </a>
    </p>
  </section>
</BaseLayout>
<style>
  .status-note {
    padding: 1.2rem;
    border-left: 3px solid var(--mint-deep);
    background: var(--paper-2);
  }
  .card-grid {
    margin-top: 2rem;
  }
  .extension-program,
  #program-status,
  #extension-projects,
  #other-extension {
    scroll-margin-top: 6rem;
  }
  .program-intro {
    margin-bottom: 3rem;
  }
  .program-projects h3,
  .program-results h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }
  .project-note,
  .catalog-link {
    margin-top: 1.2rem;
  }
  .project-note {
    max-width: 65rem;
    color: var(--ink-soft);
  }
  .project-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .project-item :global(.card) {
    flex: 1;
  }
  .program-results {
    margin-top: 2rem;
  }
  .program-results ul {
    padding-left: 1.2rem;
    margin-top: 1rem;
  }
  .independent-initiatives {
    border-top: 1px solid var(--line);
  }
</style>
