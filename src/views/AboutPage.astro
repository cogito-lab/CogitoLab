---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { localizedPath, withBase, type Lang } from '@/utils/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const description =
  lang === 'en'
    ? 'Cogito Lab is a distributed research community working across software engineering, AI, quality, IoT, and innovation.'
    : 'O Cogito Lab é uma comunidade de pesquisa distribuída que atua em engenharia de software, IA, qualidade, IoT e inovação.';
const principles =
  lang === 'en'
    ? [
        [
          'Evidence before assumption',
          'We frame questions carefully, make methods inspectable, and let results challenge our expectations.',
        ],
        [
          'Useful rigor',
          'We connect scholarly depth with software, datasets, methods, and lessons that others can use.',
        ],
        [
          'Research is collaborative',
          'Students and partners are participants in inquiry—not merely hands assigned to tasks.',
        ],
        [
          'Open by default',
          'We make our work and opportunities visible whenever ethics, privacy, and partnerships allow.',
        ],
      ]
    : [
        [
          'Evidência antes da suposição',
          'Formulamos perguntas com cuidado, tornamos os métodos examináveis e deixamos os resultados desafiarem nossas expectativas.',
        ],
        [
          'Rigor útil',
          'Conectamos profundidade acadêmica a software, dados, métodos e aprendizados que outras pessoas possam usar.',
        ],
        [
          'Pesquisa é colaboração',
          'Estudantes e parceiros participam da investigação — não são apenas mãos designadas para tarefas.',
        ],
        [
          'Aberto por padrão',
          'Tornamos nosso trabalho e oportunidades visíveis sempre que ética, privacidade e parcerias permitirem.',
        ],
      ];
---

<BaseLayout
  lang={lang}
  title={lang === 'en' ? 'About' : 'Sobre'}
  description={description}
  path="/about"
>
  <PageHero
    eyebrow={lang === 'en' ? 'About Cogito Lab' : 'Sobre o Cogito Lab'}
    title={
      lang === 'en'
        ? 'A place to think carefully and build responsibly'
        : 'Um lugar para pensar com cuidado e construir com responsabilidade'
    }
    description={description}
  />
  <section class="section container cogito-story" aria-labelledby="cogito-meaning">
    <div class="about-grid">
      <div>
        <p class="eyebrow">{lang === 'en' ? 'Why Cogito' : 'Por que Cogito'}</p>
        <h2 id="cogito-meaning">
          {lang === 'en'
            ? 'Thought becomes method. Method becomes impact.'
            : 'Pensamento vira método. Método vira impacto.'}
        </h2>
      </div>
      <div class="prose story-intro">
        <p>
          {lang === 'en'
            ? 'The name Cogito refers to René Descartes’ famous expression. We reinterpret this idea as an invitation to act: to turn thought into knowledge, and knowledge into action.'
            : 'O nome Cogito remete à célebre expressão de René Descartes. Reinterpretamos essa ideia como um convite à ação: transformar o pensamento em conhecimento e o conhecimento em ação.'}
        </p>
      </div>
    </div>
    <div class="cogito-journey">
      <figure class="cogito-expression">
        <figcaption>
          {lang === 'pt'
            ? 'O ponto de partida · René Descartes'
            : 'The starting point · René Descartes'}
        </figcaption>
        <p class="cogito-formula" lang="la">
          Cogito, ergo sum
        </p>
        <p class="cogito-translation">
          {lang === 'pt' ? '“Penso, logo existo”' : '“I think, therefore I am”'}
        </p>
      </figure>
      <span class="cogito-transition" aria-hidden="true">
        <Icon name="arrow" />
      </span>
      <figure class="cogito-expression cogito-expression--action">
        <figcaption>
          {lang === 'pt' ? 'Nosso princípio · Cogito Lab' : 'Our principle · Cogito Lab'}
        </figcaption>
        <p class="cogito-formula" lang="la">
          Cogito, ergo facio
        </p>
        <p class="cogito-translation">
          {lang === 'pt' ? '“Penso, logo faço”' : '“I think, therefore I do”'}
        </p>
      </figure>
    </div>
    <div class="about-grid story-context">
      <div class="prose">
        <p>
          {lang === 'pt'
            ? 'Para nós, pensar é uma ação: questionar suposições, construir sistemas, coletar evidências e aprender com as pessoas afetadas pela tecnologia.'
            : 'For us, thinking is an action: questioning assumptions, building systems, collecting evidence, and learning from the people affected by technology.'}
        </p>
      </div>
      <div class="prose">
        <p>
          {lang === 'en'
            ? 'Our group connects researchers and students across institutions. This distributed character lets us combine perspectives from academic research, software practice, agriculture, entrepreneurship, and public-interest technology.'
            : 'Nosso grupo conecta pesquisadores e estudantes de diferentes instituições. Esse caráter distribuído nos permite combinar perspectivas da pesquisa acadêmica, prática de software, agricultura, empreendedorismo e tecnologia de interesse público.'}
        </p>
      </div>
    </div>
  </section>
  <section class="section principles">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{lang === 'en' ? 'How we work' : 'Como trabalhamos'}</p>
          <h2>{lang === 'en' ? 'Principles in practice' : 'Princípios na prática'}</h2>
        </div>
      </div>
      <div class="principle-grid">
        {principles.map(([title, text], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section container network">
    <p class="eyebrow">{lang === 'en' ? 'Institutional network' : 'Rede institucional'}</p>
    <h2>
      {lang === 'en'
        ? 'Research without artificial borders'
        : 'Pesquisa sem fronteiras artificiais'}
    </h2>
    <p class="lede">
      {lang === 'en'
        ? 'Current member affiliations represented in the group include UFMG, UFLA, Estácio, and Saarland University.'
        : 'As afiliações atuais representadas no grupo incluem UFMG, UFLA, Estácio e Saarland University.'}
    </p>
    <div class="network-list">
      <span>UFMG</span>
      <span>UFLA</span>
      <span>Estácio</span>
      <span>Saarland University</span>
    </div>
  </section>
  <section id="contact" class="section container contact-section">
    <div class="contact-box">
      <p class="eyebrow">{lang === 'en' ? 'Get in touch' : 'Contato'}</p>
      <h2>{lang === 'en' ? 'Contact the Lab Coordinator' : 'Fale com a Coordenação'}</h2>
      <p class="lede">
        {lang === 'en'
          ? 'For research collaborations, graduate or undergraduate supervision, and institutional partnerships, contact:'
          : 'Para colaborações em pesquisa, orientações acadêmicas e parcerias institucionais, entre em contato diretamente com:'}
      </p>
      <div class="contact-card">
        <div>
          <h3>Prof. Gustavo Vale</h3>
          <p class="contact-card__sub">
            {lang === 'en'
              ? 'Lab Coordinator · Universidade Federal de Lavras (UFLA)'
              : 'Coordenador do Cogito Lab · Universidade Federal de Lavras (UFLA)'}
          </p>
        </div>
        <a class="button" href="mailto:gustavovale@ufla.br">
          gustavovale@ufla.br <Icon name="external" />
        </a>
      </div>
    </div>
  </section>
  <section class="about-cta">
    <div class="narrow">
      <h2>
        {lang === 'en'
          ? 'A good research group is always becoming.'
          : 'Um bom grupo de pesquisa está sempre se tornando.'}
      </h2>
      <p>
        {lang === 'en'
          ? 'See where your questions and skills might connect with ours.'
          : 'Veja onde suas perguntas e competências podem se conectar às nossas.'}
      </p>
      <a class="button" href={withBase(localizedPath('/opportunities', lang))}>
        {lang === 'en' ? 'Explore opportunities' : 'Explore oportunidades'}
        <Icon name="arrow" class="arrow" />
      </a>
    </div>
  </section>
</BaseLayout>
<style>
  .cogito-story .about-grid {
    align-items: center;
  }
  .story-intro {
    max-width: 36rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  }
  .cogito-journey {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    margin-block: clamp(2rem, 4vw, 3.5rem);
  }
  .cogito-expression {
    padding: clamp(1.5rem, 3vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .cogito-expression--action {
    background: color-mix(in srgb, var(--mint) 30%, var(--surface));
  }
  .cogito-expression figcaption {
    color: var(--ink-soft);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .cogito-formula {
    margin-block: 1.5rem 0.7rem;
    font-family: Georgia, serif;
    font-size: clamp(1.7rem, 3.3vw, 2.8rem);
    font-style: italic;
    line-height: 1.15;
  }
  .cogito-translation {
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .cogito-transition {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .cogito-transition :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .story-context .prose p {
    margin-block: 0;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 8vw, 8rem);
  }
  .about-grid h2 {
    font-size: clamp(2.2rem, 5vw, 4.3rem);
  }
  .principles {
    background: var(--paper-2);
  }
  .principle-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .principle-grid article {
    min-height: 17rem;
    padding: 2rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .principle-grid span {
    color: var(--mint-deep);
    font-family: Georgia, serif;
    font-style: italic;
  }
  .principle-grid h3 {
    margin-block: 3rem 1rem;
  }
  .principle-grid p {
    color: var(--ink-soft);
  }
  .network {
    text-align: center;
  }
  .network .eyebrow {
    justify-content: center;
  }
  .network .lede {
    margin-inline: auto;
  }
  .network-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 2.5rem;
  }
  .network-list span {
    padding: 0.8rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 740;
    background: var(--surface);
  }
  .contact-section {
    padding-block: clamp(3rem, 6vw, 6rem);
  }
  .contact-box {
    max-width: 820px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .contact-box h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 1rem;
  }
  .contact-box .lede {
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
  .contact-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .contact-card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.25rem;
  }
  .contact-card__sub {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .about-cta {
    padding-block: clamp(5rem, 10vw, 9rem);
    text-align: center;
    background: var(--mint);
    color: #10231d;
  }
  .about-cta h2 {
    margin-bottom: 1rem;
  }
  .about-cta p {
    margin-bottom: 2rem;
    font-size: 1.15rem;
  }
  .about-cta .button {
    color: #f5f1e8;
    border-color: #10231d;
    background: #10231d;
  }
  @media (max-width: 700px) {
    .cogito-journey {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
    .cogito-transition {
      justify-self: center;
      transform: rotate(90deg);
    }
    .about-grid,
    .principle-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
