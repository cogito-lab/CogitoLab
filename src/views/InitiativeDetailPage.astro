---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { render, getCollection } from 'astro:content';
import MemberCard from '@/components/MemberCard.astro';
import OpportunityCard from '@/components/OpportunityCard.astro';
import Icon from '@/components/Icon.astro';
import InitiativeCard from '@/components/InitiativeCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { pillars, entityTypeLabels } from '@/data/pillars';
import {
  developmentStageLabels,
  executionStatusLabels,
  organizationRelationshipLabels,
} from '@/data/technology';
import { publicOrganization } from '@/utils/relations';
import {
  hasParticipation,
  initiativeConnections,
  relationLabels,
  explicitlyLinked,
} from '@/utils/connections';
import type { Initiative } from '@/utils/content';
import {
  entrySlug,
  getOpportunities,
  getPeople,
  getInitiatives,
  getNews,
  getPrograms,
} from '@/utils/content';
import { getArea } from '@/data/areas';
import { localizedPath, skillLabel, pick, t, withBase, type Lang } from '@/utils/i18n';
interface Props {
  lang: Lang;
  initiative: Initiative;
}
const { lang, initiative } = Astro.props;
const copy = t(lang);
const slug = entrySlug(initiative.id);
const [allPeople, allOpportunities, allInitiatives, allNews, allPrograms, allPublications] =
  await Promise.all([
    getPeople(),
    getOpportunities(),
    getInitiatives(),
    getNews(),
    getPrograms(),
    getCollection('publications'),
  ]);
const people = allPeople.filter((person) => hasParticipation(person, initiative));
const related = initiativeConnections(initiative, allInitiatives);
const news = explicitlyLinked(allNews, slug);
const publications = explicitlyLinked(allPublications, slug).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title)
);
const program = allPrograms.find((entry) => entrySlug(entry.id) === initiative.data.program);
const organization = publicOrganization(initiative.data.organization);
const pillar = pillars.find((item) => item.id === initiative.data.primaryPillar)!;
const programPillar = program && pillars.find((item) => item.id === program.data.primaryPillar)!;
const opportunities = allOpportunities.filter(
  (opportunity) => opportunity.data.initiative === slug
);
const path = `/initiatives/${slug}`;
const { Content } = await render(initiative);
---

<BaseLayout
  lang={lang}
  title={pick(initiative.data.title, lang)}
  description={pick(initiative.data.summary, lang)}
  path={path}
>
  <header class="initiative-hero">
    <div class="container">
      <a class="back-link" href={withBase(localizedPath('/initiatives', lang))}>
        ← {copy.initiatives}
      </a>
      <div class="hero-meta">
        <span class="tag">
          <i class="status-dot"></i>
          {pick(executionStatusLabels[initiative.data.status], lang)}
        </span>
        <span class="tag">{pick(pillar.title, lang)}</span>
        <span class="tag">{pick(entityTypeLabels[initiative.data.entityType], lang)}</span>
      </div>
      <h1>{pick(initiative.data.title, lang)}</h1>
      <p class="lede">{pick(initiative.data.summary, lang)}</p>
      {program && programPillar && (
        <p>
          <a
            href={withBase(localizedPath(`${programPillar.route}#${entrySlug(program.id)}`, lang))}
          >
            {initiative.data.extensionCode && `${initiative.data.extensionCode} · `}
            {pick(program.data.name, lang)}
          </a>
        </p>
      )}
    </div>
  </header>
  <section class="section container detail-layout">
    <article class="prose">
      <Content />
      {pick(initiative.data.defined, lang).length > 0 && (
        <section id="established">
          <h2>{copy.defined}</h2>
          <ul>
            {pick(initiative.data.defined, lang).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}
      {pick(initiative.data.work, lang).length > 0 && (
        <section id="planned-work">
          <h2>{copy.work}</h2>
          <ol>
            {pick(initiative.data.work, lang).map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </section>
      )}
      {initiative.data.achievedResults.length > 0 && (
        <section id="achieved-results">
          <h2>{lang === 'pt' ? 'Resultados alcançados' : 'Achieved results'}</h2>
          <ul>
            {initiative.data.achievedResults.map((result) => (
              <li>
                {result.url ? (
                  <a href={result.url}>{pick(result.description, lang)}</a>
                ) : (
                  pick(result.description, lang)
                )}
                {result.date && (
                  <>
                    {' '}
                    · <time datetime={result.date}>{result.date}</time>
                  </>
                )}
                {result.indicator && (
                  <>
                    {' '}
                    · {result.indicator.value} {pick(result.indicator.unit, lang)}
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      )}
      {pick(initiative.data.expectedResults, lang).length > 0 && (
        <section id="expected-results">
          <h2>{lang === 'pt' ? 'Resultados esperados' : 'Expected results'}</h2>
          <ul>
            {pick(initiative.data.expectedResults, lang).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )}
    </article>
    <aside class="detail-aside">
      <dl>
        <div>
          <dt>{copy.status}</dt>
          <dd>{pick(initiative.data.statusLabel, lang)}</dd>
        </div>
        <div>
          <dt>{copy.type}</dt>
          <dd>{pick(entityTypeLabels[initiative.data.entityType], lang)}</dd>
        </div>
        {initiative.data.relatedPillars.length > 0 && (
          <div>
            <dt>{lang === 'pt' ? 'Outros pilares relacionados' : 'Other related pillars'}</dt>
            <dd>
              {initiative.data.relatedPillars.map((id) => {
                const relatedPillar = pillars.find((item) => item.id === id)!;
                return (
                  <p>
                    <a href={withBase(localizedPath(relatedPillar.route, lang))}>
                      {pick(relatedPillar.title, lang)}
                    </a>
                  </p>
                );
              })}
            </dd>
          </div>
        )}
        {initiative.data.funding && (
          <div>
            <dt>{copy.funded}</dt>
            <dd>
              {initiative.data.funding.agency}
              <br />
              {initiative.data.funding.process}
              {initiative.data.funding.period && (
                <>
                  <br />
                  {initiative.data.funding.period}
                </>
              )}
            </dd>
          </div>
        )}
        {initiative.data.developmentStage && (
          <div data-development-stage>
            <dt>{lang === 'pt' ? 'Estágio de desenvolvimento' : 'Development stage'}</dt>
            <dd>{pick(developmentStageLabels[initiative.data.developmentStage], lang)}</dd>
          </div>
        )}
        {organization && (
          <div data-public-organization>
            <dt>
              {lang === 'pt' ? 'Organização' : 'Organization'} ·{' '}
              {pick(
                organizationRelationshipLabels[initiative.data.organization!.relationship],
                lang
              )}
            </dt>
            <dd>
              {organization.website ? (
                <a href={organization.website}>{pick(organization.label, lang)}</a>
              ) : (
                pick(organization.label, lang)
              )}
              {organization.logo && (
                <img
                  src={
                    organization.logo.startsWith('/')
                      ? withBase(organization.logo)
                      : organization.logo
                  }
                  alt={pick(organization.label, lang)}
                  width="120"
                  height="60"
                  loading="lazy"
                />
              )}
            </dd>
          </div>
        )}
      </dl>
      {initiative.data.skills.length > 0 && (
        <>
          <hr class="rule" />
          <p class="eyebrow">{copy.skills}</p>
          <ul class="tag-list">
            {initiative.data.skills.map((skill) => (
              <li class="tag">{skillLabel(skill, lang)}</li>
            ))}
          </ul>
        </>
      )}
      {pick(initiative.data.participation, lang).length > 0 && (
        <>
          <hr class="rule" />
          <p class="eyebrow">{copy.participation}</p>
          <ul class="aside-list">
            {pick(initiative.data.participation, lang).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </>
      )}
    </aside>
  </section>
  {initiative.data.areas.length > 0 && (
    <section class="section connections">
      <div class="container">
        <h2 class="eyebrow">
          {lang === 'en' ? 'Related research areas' : 'Áreas de pesquisa relacionadas'}
        </h2>
        <div class="connection-list">
          {initiative.data.areas.map((id) => {
            const area = getArea(id);
            return (
              area && (
                <a href={withBase(localizedPath(`/research#${id}`, lang))}>
                  <span>{area.number}</span>
                  <strong>{pick(area.title, lang)}</strong>
                  <Icon name="arrow" />
                </a>
              )
            );
          })}
        </div>
      </div>
    </section>
  )}
  {related.length > 0 && (
    <section class="section container" id="related-initiatives">
      <div class="section-heading">
        <h2>{copy.relatedInitiatives}</h2>
      </div>
      <div class="card-grid">
        {related.map(({ entry, relation, incoming, reverseRelation }) => (
          <div>
            <p class="eyebrow">
              {pick(relationLabels[relation][incoming ? 'incoming' : 'outgoing'], lang)}
              {reverseRelation && <> · {pick(relationLabels[reverseRelation].incoming, lang)}</>}
            </p>
            <InitiativeCard initiative={entry} lang={lang} showClassification />
          </div>
        ))}
      </div>
    </section>
  )}
  {publications.length > 0 && (
    <section class="section container" id="initiative-publications">
      <div class="section-heading">
        <h2>{copy.publications}</h2>
      </div>
      {publications.map((publication) => (
        <PublicationItem publication={publication} lang={lang} showInitiatives={false} />
      ))}
    </section>
  )}
  {news.length > 0 && (
    <section class="section container" id="initiative-news">
      <div class="section-heading">
        <h2>{lang === 'pt' ? 'Notícias relacionadas' : 'Related news'}</h2>
      </div>
      <div class="card-grid">
        {news.map((item) => (
          <NewsCard news={item} lang={lang} />
        ))}
      </div>
    </section>
  )}
  {people.length > 0 && (
    <section class="section container" id="initiative-people">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.relatedPeople}</p>
          <h2>{lang === 'en' ? 'People behind the work' : 'Pessoas por trás do trabalho'}</h2>
        </div>
      </div>
      <div class="card-grid">
        {people.map((person) => (
          <MemberCard person={person} lang={lang} />
        ))}
      </div>
    </section>
  )}
  {opportunities.length > 0 && (
    <section class="section opportunities" id="initiative-opportunities">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{copy.relatedOpportunities}</p>
            <h2>{lang === 'en' ? 'There is room to contribute' : 'Há espaço para contribuir'}</h2>
          </div>
        </div>
        <div class="card-grid">
          {opportunities.map((opportunity) => (
            <OpportunityCard opportunity={opportunity} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .initiative-hero {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--mint) 25%, transparent),
      transparent 55%
    );
  }
  .initiative-hero h1 {
    max-width: 1100px;
    margin-block: 1.5rem;
    font-size: clamp(3rem, 7.5vw, 6.8rem);
  }
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .aside-list {
    padding-left: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.86rem;
  }
  .aside-list li + li {
    margin-top: 0.4rem;
  }
  .connections {
    color: var(--paper);
    background: var(--ink);
  }
  .connections .eyebrow {
    color: color-mix(in srgb, var(--paper) 65%, transparent);
  }
  .connection-list {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
  }
  .connection-list a {
    display: grid;
    grid-template-columns: 4rem 1fr 2rem;
    gap: 1rem;
    align-items: center;
    padding-block: 1.3rem;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 20%, transparent);
    text-decoration: none;
  }
  .connection-list span {
    font-family: Georgia, serif;
    font-style: italic;
  }
  .connection-list strong {
    font-family: Georgia, serif;
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 500;
  }
  .connection-list svg {
    width: 1.1rem;
  }
  .opportunities {
    background: var(--paper-2);
  }
</style>
