---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { localizedPath, t, withBase, type Lang } from '@/utils/i18n';
interface Props { lang: Lang; path: string }
const { lang, path } = Astro.props;
const copy = t(lang);
const alternate = lang === 'en' ? 'pt' : 'en';
---
<header class="site-header">
  <div class="header-inner container">
    <Logo lang={lang} />
    <nav class="desktop-nav" aria-label="Primary navigation">
      {copy.nav.map((label, index) => {
        const route = `/${copy.routes[index]}`;
        const active = path === route || path.startsWith(`${route}/`);
        return <a href={withBase(localizedPath(route, lang))} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
    <div class="header-actions">
      <a class="language" href={withBase(localizedPath(path, alternate))} lang={alternate} aria-label={copy.language}>{alternate.toUpperCase()}</a>
      <button class="icon-button" type="button" data-theme-toggle aria-label={copy.theme}><Icon name="sun" /></button>
      <button class="icon-button menu-button" type="button" data-menu-open aria-label={copy.menu} aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
    </div>
  </div>
  <div class="mobile-panel" id="mobile-nav" data-mobile-panel hidden>
    <div class="mobile-panel__top container">
      <Logo lang={lang} />
      <button class="icon-button" type="button" data-menu-close aria-label={copy.close}><Icon name="close" /></button>
    </div>
    <nav class="mobile-nav container" aria-label="Mobile navigation">
      {copy.nav.map((label, index) => <a href={withBase(localizedPath(`/${copy.routes[index]}`, lang))}>{label}<Icon name="arrow" /></a>)}
      <a href={withBase(localizedPath(path, alternate))} lang={alternate}>{copy.language}<Icon name="arrow" /></a>
    </nav>
  </div>
</header>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const saved = localStorage.getItem('cogito-theme');
    if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) root.dataset.theme = 'dark';
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('cogito-theme', root.dataset.theme);
    });
    const panel = document.querySelector('[data-mobile-panel]');
    const opener = document.querySelector('[data-menu-open]');
    const close = () => { if (panel) panel.hidden = true; opener?.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; };
    opener?.addEventListener('click', () => { if (panel) panel.hidden = false; opener.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; panel?.querySelector('a')?.focus(); });
    document.querySelector('[data-menu-close]')?.addEventListener('click', close);
    panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    addEventListener('keydown', (event) => { if (event.key === 'Escape') close(); });
  })();
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 84%, transparent); backdrop-filter: blur(18px); }
  .header-inner { display: flex; min-height: 4.7rem; gap: 1.3rem; align-items: center; justify-content: space-between; }
  .desktop-nav { display: flex; gap: clamp(.75rem, 2vw, 1.7rem); margin-left: auto; }
  .desktop-nav a { position: relative; color: var(--ink-soft); font-size: .78rem; font-weight: 680; text-decoration: none; }
  .desktop-nav a::after { position: absolute; right: 0; bottom: -.55rem; left: 0; height: 2px; content: ''; transform: scaleX(0); background: var(--mint-deep); transition: transform .2s ease; }
  .desktop-nav a:hover, .desktop-nav a[aria-current='page'] { color: var(--ink); }
  .desktop-nav a:hover::after, .desktop-nav a[aria-current='page']::after { transform: scaleX(1); }
  .header-actions { display: flex; gap: .4rem; align-items: center; }
  .language, .icon-button { display: grid; min-width: 2.55rem; height: 2.55rem; place-items: center; border: 1px solid var(--line); border-radius: 50%; color: var(--ink); background: transparent; font-size: .7rem; font-weight: 780; text-decoration: none; cursor: pointer; }
  .icon-button svg { width: 1.1rem; height: 1.1rem; }
  .language:hover, .icon-button:hover { background: var(--surface); }
  .menu-button { display: none; }
  .mobile-panel { position: fixed; inset: 0; z-index: 60; overflow-y: auto; color: var(--ink); background: var(--paper); }
  .mobile-panel__top { display: flex; min-height: 4.7rem; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .mobile-nav { display: grid; padding-block: 2rem; }
  .mobile-nav a { display: flex; align-items: center; justify-content: space-between; padding-block: 1rem; border-bottom: 1px solid var(--line); font-family: Georgia, serif; font-size: clamp(1.6rem, 8vw, 2.7rem); text-decoration: none; }
  .mobile-nav svg { width: 1.4rem; }
  @media (max-width: 980px) { .desktop-nav { display: none; } .menu-button { display: grid; } }
</style>
