---
import type { Initiative } from '@/utils/content';
import { entrySlug } from '@/utils/content';
import { localizedPath, pick, t, withBase, type Lang } from '@/utils/i18n';
import Icon from './Icon.astro';
import { pillars, entityTypeLabels } from '@/data/pillars';
import { developmentStageLabels, organizationRelationshipLabels } from '@/data/technology';
import { publicOrganization } from '@/utils/relations';
interface Props {
  initiative: Initiative;
  lang: Lang;
  index?: number;
  showClassification?: boolean;
  headingLevel?: 'h3' | 'h4';
  showActivities?: boolean;
  showInstitutionalStatus?: boolean;
  showTechnologyDetails?: boolean;
  programLabel?: { en: string; pt: string };
  programPath?: string;
}
const {
  initiative,
  lang,
  index,
  showClassification = false,
  headingLevel: Heading = 'h3',
  showActivities = false,
  showInstitutionalStatus = false,
  showTechnologyDetails = false,
  programLabel,
  programPath,
} = Astro.props;
const slug = entrySlug(initiative.id);
const copy = t(lang);
const tone = ['mint', 'blue', 'amber', 'violet', 'coral'][(index ?? initiative.data.order) % 5];
const organization = showTechnologyDetails
  ? publicOrganization(initiative.data.organization)
  : undefined;
---

<article
  class={`card card--${tone}`}
  data-filter-item
  data-search={`${pick(initiative.data.title, lang)} ${pick(initiative.data.summary, lang)} ${initiative.data.skills.join(' ')} ${initiative.data.areas.join(' ')}`.toLowerCase()}
  data-kind={initiative.data.kind}
  data-status={initiative.data.status}
  data-pillar={initiative.data.primaryPillar}
  data-entity-type={initiative.data.entityType}
  data-pillars={[initiative.data.primaryPillar, ...initiative.data.relatedPillars].join(' ')}
  data-areas={initiative.data.areas.join(' ')}
>
  <a class="card__link" href={withBase(localizedPath(`/initiatives/${slug}`, lang))}>
    <span class="sr-only">{pick(initiative.data.title, lang)}</span>
  </a>
  <div class="card__top">
    <span class="tag">
      <i class="status-dot"></i>
      {showClassification
        ? initiative.data.status === 'active'
          ? lang === 'pt'
            ? 'Em execução'
            : 'In progress'
          : copy[initiative.data.status]
        : initiative.data.extensionCode
          ? lang === 'pt'
            ? 'Informado como registrado'
            : 'Reported as registered'
          : copy[initiative.data.status]}
    </span>
    {index !== undefined && <span class="card__index">{String(index + 1).padStart(2, '0')}</span>}
  </div>
  <div class="card__body">
    <p class="person-card__role">
      {showClassification
        ? pick(pillars.find((pillar) => pillar.id === initiative.data.primaryPillar)!.title, lang)
        : pick(initiative.data.kindLabel, lang)}
    </p>
    {showClassification && (
      <p class="person-card__role">{pick(entityTypeLabels[initiative.data.entityType], lang)}</p>
    )}
    <Heading class="initiative-title">
      {pick(initiative.data.shortTitle ?? initiative.data.title, lang)}
    </Heading>
    <p>{pick(initiative.data.summary, lang)}</p>
    {programLabel && programPath && (
      <p class="program-link">
        <a href={withBase(localizedPath(programPath, lang))}>{pick(programLabel, lang)}</a>
      </p>
    )}
    {showTechnologyDetails && (initiative.data.developmentStage || organization) && (
      <dl class="technology-details">
        {initiative.data.developmentStage && (
          <div data-development-stage>
            <dt>{lang === 'pt' ? 'Estágio de desenvolvimento' : 'Development stage'}</dt>
            <dd>{pick(developmentStageLabels[initiative.data.developmentStage], lang)}</dd>
          </div>
        )}
        {organization && (
          <div data-public-organization>
            <dt>
              {lang === 'pt' ? 'Organização' : 'Organization'} ·{' '}
              {pick(
                organizationRelationshipLabels[initiative.data.organization!.relationship],
                lang
              )}
            </dt>
            <dd>
              {organization.website ? (
                <a href={organization.website}>{pick(organization.label, lang)}</a>
              ) : (
                pick(organization.label, lang)
              )}
              {organization.logo && (
                <img
                  src={
                    organization.logo.startsWith('/')
                      ? withBase(organization.logo)
                      : organization.logo
                  }
                  alt={pick(organization.label, lang)}
                  loading="lazy"
                  width="120"
                  height="60"
                />
              )}
            </dd>
          </div>
        )}
      </dl>
    )}
    {showInstitutionalStatus && (
      <p class="institutional-status">{pick(initiative.data.statusLabel, lang)}</p>
    )}
    {showActivities && pick(initiative.data.expectedResults, lang).length > 0 && (
      <div class="activity-preview">
        <p>
          <strong>{lang === 'pt' ? 'Possibilidades de atuação' : 'Possible activities'}</strong>
        </p>
        <ul>
          {pick(initiative.data.expectedResults, lang)
            .slice(0, 3)
            .map((activity) => (
              <li>{activity}</li>
            ))}
        </ul>
      </div>
    )}
  </div>
  <div class="card__footer">
    <ul class="tag-list">
      {initiative.data.skills.slice(0, 2).map((skill) => (
        <li class="tag">{skill}</li>
      ))}
    </ul>
    <span class="card__arrow">
      <Icon name="arrow" class="arrow" />
    </span>
  </div>
</article>

<style>
  .program-link {
    margin-top: 1rem;
  }
  .program-link a {
    position: relative;
    z-index: 2;
  }
  .technology-details {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: 0.85rem;
  }
  .technology-details dt {
    font-weight: 700;
  }
  .technology-details dd {
    margin: 0.2rem 0 0;
    color: var(--ink-soft);
  }
  .technology-details a {
    position: relative;
    z-index: 2;
  }
  .technology-details img {
    margin-top: 0.5rem;
    object-fit: contain;
    object-position: left;
  }
  .initiative-title {
    margin: 0 0 0.75rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .institutional-status,
  .activity-preview {
    margin-top: 1rem;
  }
  .activity-preview ul {
    margin-top: 0.5rem;
    padding-left: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }
  .activity-preview li + li {
    margin-top: 0.35rem;
  }
</style>
