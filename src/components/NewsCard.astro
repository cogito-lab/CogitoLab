---
import type { News } from '@/utils/content';
import { pick, type Lang } from '@/utils/i18n';
import Icon from './Icon.astro';

interface Props {
  news: News;
  lang: Lang;
}

const { news, lang } = Astro.props;
---

<article class="card news-card">
  <div class="card__top">
    <span class="tag tag--accent">{pick(news.data.categoryLabel, lang)}</span>
    <time class="news-date" datetime={news.data.date}>
      {pick(news.data.displayDate, lang)}
    </time>
  </div>
  <div class="card__body">
    <h3>{pick(news.data.title, lang)}</h3>
    <p>{pick(news.data.summary, lang)}</p>
  </div>
  {news.data.links && news.data.links.length > 0 && (
    <div class="news-links">
      {news.data.links.map((link) => (
        <a class="news-link-item" href={link.url} target="_blank" rel="noopener noreferrer">
          {link.label} <Icon name="external" />
        </a>
      ))}
    </div>
  )}
</article>

<style>
  .news-card {
    min-height: 19rem;
    display: flex;
    flex-direction: column;
  }
  .news-card .card__top {
    margin-bottom: 0;
  }
  .news-card .card__body {
    flex: 1 1 auto;
    margin-block: 1.25rem 1.5rem;
  }
  .news-date {
    font-size: 0.76rem;
    color: var(--ink-soft);
    font-family: Georgia, serif;
    font-style: italic;
  }
  .tag--accent {
    color: var(--mint-deep);
    border-color: color-mix(in srgb, var(--mint-deep) 35%, transparent);
    background: color-mix(in srgb, var(--mint) 25%, transparent);
    font-weight: 700;
  }
  .news-links {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    position: relative;
    z-index: 2;
  }
  .news-link-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.15rem;
    min-height: 2.15rem;
    max-height: 2.15rem;
    box-sizing: border-box;
    padding: 0 0.85rem;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 65%, transparent);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }
  .news-link-item:hover {
    background: var(--surface);
    border-color: var(--mint-deep);
    color: var(--mint-deep);
  }
  .news-link-item svg {
    width: 0.85rem;
    height: 0.85rem;
    flex-shrink: 0;
  }
</style>
