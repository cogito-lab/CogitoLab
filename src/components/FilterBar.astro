---
import type { Lang } from '@/utils/i18n';
interface Option {
  value: string;
  label: string;
}
interface Props {
  lang: Lang;
  options?: Option[];
  statuses?: Option[];
  kindAttribute?: 'kind' | 'entityType';
  allowReset?: boolean;
  pillars?: Option[];
  areas?: Option[];
}
const {
  lang,
  options = [],
  statuses = [],
  kindAttribute = 'kind',
  allowReset = false,
  pillars = [],
  areas = [],
} = Astro.props;
---

<div class="filter-bar" data-filter-root data-kind-attribute={kindAttribute} hidden>
  <label for="content-search">{lang === 'en' ? 'Search' : 'Buscar'}</label>
  <input
    id="content-search"
    type="search"
    data-filter-search
    placeholder={
      lang === 'en' ? 'Search by name, topic, or skill…' : 'Busque por nome, tema ou competência…'
    }
  />
  {pillars.length > 0 && (
    <>
      <label for="pillar-filter">{lang === 'pt' ? 'Filtrar por pilar' : 'Filter by pillar'}</label>
      <select id="pillar-filter" data-filter-pillar>
        <option value="">{lang === 'pt' ? 'Todos os pilares' : 'All pillars'}</option>
        {pillars.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </>
  )}
  {areas.length > 0 && (
    <>
      <label for="area-filter">{lang === 'pt' ? 'Filtrar por área' : 'Filter by area'}</label>
      <select id="area-filter" data-filter-area>
        <option value="">{lang === 'pt' ? 'Todas as áreas' : 'All areas'}</option>
        {areas.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </>
  )}
  {options.length > 0 && (
    <>
      <label for="type-filter">{lang === 'en' ? 'Filter by type' : 'Filtrar por tipo'}</label>
      <select id="type-filter" data-filter-kind>
        <option value="">{lang === 'en' ? 'All types' : 'Todos os tipos'}</option>
        {options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </>
  )}
  {statuses.length > 0 && (
    <>
      <label for="status-filter">
        {lang === 'en' ? 'Filter by status' : 'Filtrar por situação'}
      </label>
      <select id="status-filter" data-filter-status>
        <option value="">{lang === 'en' ? 'All statuses' : 'Todas as situações'}</option>
        {statuses.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </>
  )}
  {allowReset && (
    <button class="button button--ghost" type="button" data-filter-clear>
      {lang === 'pt' ? 'Limpar filtros' : 'Clear filters'}
    </button>
  )}
</div>
<p class="muted" data-filter-empty role="status" hidden>
  {lang === 'en'
    ? 'No results match these filters.'
    : 'Nenhum resultado corresponde a estes filtros.'}
</p>
<script>
  document.querySelectorAll('[data-filter-root]').forEach((root) => {
    root.removeAttribute('hidden');
    const section = root.parentElement;
    const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
    const kind = root.querySelector<HTMLSelectElement>('[data-filter-kind]');
    const status = root.querySelector<HTMLSelectElement>('[data-filter-status]');
    const pillar = root.querySelector<HTMLSelectElement>('[data-filter-pillar]');
    const area = root.querySelector<HTMLSelectElement>('[data-filter-area]');
    const items = [...(section?.querySelectorAll<HTMLElement>('[data-filter-item]') ?? [])];
    const empty = section?.querySelector<HTMLElement>('[data-filter-empty]');
    const kindAttribute = (root as HTMLElement).dataset.kindAttribute ?? 'kind';
    const update = () => {
      const query = search?.value.trim().toLowerCase() ?? '';
      let shown = 0;
      items.forEach((item) => {
        const matches =
          (!query || item.dataset.search?.includes(query)) &&
          (!kind?.value ||
            item.dataset[kindAttribute] === kind.value ||
            item.dataset.category === kind.value) &&
          (!status?.value || item.dataset.status === status.value) &&
          (!pillar?.value || (item.dataset.pillars ?? '').split(' ').includes(pillar.value)) &&
          (!area?.value || (item.dataset.areas ?? '').split(' ').includes(area.value));
        item.hidden = !matches;
        if (matches) shown++;
      });
      section?.querySelectorAll<HTMLElement>('[data-filter-group]').forEach((group) => {
        group.hidden = !group.querySelector('[data-filter-item]:not([hidden])');
      });
      if (empty) empty.hidden = shown > 0;
    };
    [search, kind, status, pillar, area].forEach((control) => {
      control?.addEventListener('input', update);
      control?.addEventListener('change', update);
    });
    root.querySelector('[data-filter-clear]')?.addEventListener('click', () => {
      if (search) search.value = '';
      if (kind) kind.value = '';
      if (status) status.value = '';
      if (pillar) pillar.value = '';
      if (area) area.value = '';
      update();
      search?.focus();
    });
    update();
  });
</script>

<style>
  .filter-bar select {
    min-width: 0;
    max-width: 100%;
  }
</style>
